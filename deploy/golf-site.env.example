# The site's configuration, installed as /etc/golf-site/env (owner root, mode 0600).
# Every variable is described in README.md under "Running the site".
#
# Never set GOLF_DEV_LOGIN here. Keep GOLF_SESSION_SECRET fixed: changing it signs
# everyone out.

GOLF_DATABASE=/var/lib/golf-site/golf_site.db
GOLF_ROM_DIR=/var/lib/golf-site/roms
GOLF_HOLES_DIR=/var/lib/golf-site/courses
GOLF_RANGEFINDER_DIR=/var/lib/golf-site/rangefinder
GOLF_BASE_URL=https://nesopengolf.com

GOLF_DISCORD_CLIENT_ID=replace-me
GOLF_DISCORD_CLIENT_SECRET=replace-me
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GOLF_SESSION_SECRET=replace-me
# Discord user ids, separated by commas or spaces
GOLF_ADMIN_USERS=replace-me
